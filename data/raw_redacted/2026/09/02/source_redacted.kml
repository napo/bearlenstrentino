          <coordinates>
            11.0661725,46.0864405,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Sardagna</name>
        <description>&lt;img src="https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR6ni_FY6oObx3Xc_cd3E9JEoT835jK5iNiE7zLM2D7wC8m812oduB1P_bPqSoOU7qD5SuscUIg86Jg2qBo9VDhfkJl_firG0DLzKcXLvN9zNbVuYGcV7CoxPDs3UVvsGnEuBa9J5HZmtOHU_78sAY3XfovX8Jq6q4Pr1awAamomBPwINlizSDSnN_QLLnRoWwoT5ZNlBCr2nXXb--qH6NruFCgUSdAxaQmEJfKAZrF6HiL9a-yYYGI6pbg?fife=s16383" height="200" width="auto" /&gt;&lt;br&gt;&lt;br&gt;</description>
